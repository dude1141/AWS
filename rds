import json
import boto3
import pandas as pd
from sqlalchemy import create_engine
from botocore.exceptions import ClientError


def get_secret():
    secret_name = "/dev/rds/database2"
    region_name = "us-east-1"

    session = boto3.session.Session()
    client = session.client(
        service_name="secretsmanager",
        region_name=region_name
    )

    try:
        response = client.get_secret_value(SecretId=secret_name)
    except ClientError as e:
        raise RuntimeError(f"Failed to fetch secret: {e}")

    return json.loads(response["SecretString"])


# ------------------- MAIN LOGIC -------------------

print("Step 1: Fetching secrets")

secret = get_secret()

host = secret["host"]
user = secret["username"]
password = secret["password"]
database = secret["dbname"]
port = secret.get("port", 3306)

print("Step 2: Reading CSV")

csv_file_path = r"C:\Users\mouni\Downloads\Salescsvfile.csv"
df = pd.read_csv(csv_file_path)

print("Step 3: Creating DB engine")

engine = create_engine(
    f"mysql+pymysql://{user}:{password}@{host}:{port}/{database}"
)

print("Step 4: Loading data")

table_name = "sales"

try:
    df.to_sql(
        table_name,
        con=engine,
        index=False,
        if_exists="append",   # DO NOT use replace
        method="multi",
        chunksize=1000
    )
    print("Data successfully loaded into MySQL RDS")
except Exception as e:
    print("ERROR while loading data:", e)




